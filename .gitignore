# ============================================================
# VERSIN - .gitignore
# Flutter + Dart + Python/FastAPI + Node.js + Supabase
# ============================================================


# ============================================================
# SECRETS / VARIÁVEIS DE AMBIENTE
# ============================================================

.env
.env.*
.env.local
.env.*.local

# dotenvx
.env.keys

# Modelo de configuração pode ser versionado
!.env.example
!.env.*.example


# ============================================================
# CREDENCIAIS / CHAVES / CERTIFICADOS
# ============================================================

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

credentials.json
service-account.json
service_account.json

secrets.json
secrets.yaml
secrets.yml


# ============================================================
# MISCELLANEOUS
# ============================================================

*.class
*.log
*.pyc
*.swp
*.swo
*.tmp
*.temp
*.bak

.DS_Store

.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/

migrate_working_dir/

.cache/
tmp/
temp/


# ============================================================
# INTELLIJ / ANDROID STUDIO
# ============================================================

*.iml
*.ipr
*.iws

.idea/


